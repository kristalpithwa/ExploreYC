{
  "expo": {
    "name": "ExploreYC",
    "slug": "ExploreYC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "exploreyc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kristalpithwa.ExploreYC"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.kristalpithwa.ExploreYC"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6600",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 500
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
